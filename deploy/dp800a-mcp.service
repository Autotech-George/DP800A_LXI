[Unit]
Description=DP800A MCP server (Streamable HTTP transport)
# Standalone: with the default `auto` backend the MCP server drives the
# instrument itself when dp800a-web is not running, and goes through dp800a-web
# (sharing its VISA session with the GUI) when it is. Use --backend local|rest to
# force one path.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tech
WorkingDirectory=/home/tech/DP800A_LXI
# Adjust the path if the venv lives elsewhere, or point at the dp800a-mcp entry
# point from however the package was installed on this host.
ExecStart=/home/tech/DP800A_LXI/.venv/bin/dp800a-mcp --http --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=2

# The web backend URL defaults to http://127.0.0.1:8765; pin it explicitly if needed.
#Environment=DP800A_API_BASE=http://127.0.0.1:8765
#Environment=DP800A_MCP_BACKEND=auto

[Install]
WantedBy=multi-user.target
